      <property name="styleSheet">
       <string notr="true">QScrollBar:vertical {
    border: 0px solid #dcdcdc; /* Border around the scrollbar */
    background: #f5f5f5;       /* Background of the scrollbar area */
    width: 12px;               /* Width of the scrollbar */
    margin: 0px 0px 0px 0px;   /* Margins around the scrollbar */
}

QScrollBar::handle:vertical {
    background: #888;          /* Color of the scrollbar handle */
    min-height: 10px;          /* Minimum height of the scrollbar handle */
    border-radius: 5px;        /* Rounded corners of the scrollbar handle */
}
QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    background: #dcdcdc;       /* Background color of arrow buttons */
    border: 1px solid #aaa;    /* Border around the arrow buttons */
    height: 12px;              /* Height of arrow buttons */
    subcontrol-origin: margin;
    subcontrol-position: top;  /* Positions at top and bottom */
}
QScrollArea {
    background: none; /* Background color for the scroll area */
    border: 2px solid black; /* Optional border */
  
}</string>
